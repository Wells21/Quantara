# =====================================================================
# QUANTARA — GIT LFS / BINARY ARTIFACT POLICY
# =====================================================================
#
# Large canonical CSV artifacts are stored using Git LFS.
#
# "-text" is deliberate:
# Quantara manifests/hash contracts depend on exact artifact bytes.
# Git must not perform CRLF/LF text normalization on these files.
# =====================================================================


# =====================================================================
# 1. LARGE STATIC ASSET-LEVEL DATA
# =====================================================================

trading_models_v2/assets/*/bars/standard_quote_tick/*_standard_quote_tick_bars.csv filter=lfs diff=lfs merge=lfs -text

trading_models_v2/assets/*/bars/ffd/*_ffd_features.csv filter=lfs diff=lfs merge=lfs -text

trading_models_v2/assets/*/bars/regime/*_hmm_regime_features.csv filter=lfs diff=lfs merge=lfs -text


# =====================================================================
# 2. SMALL BAR-CONTRACT CSVs
# =====================================================================
#
# These remain ordinary Git files because they are tiny.
# -text prevents newline conversion from changing artifact hashes.
# =====================================================================

trading_models_v2/assets/*/bars/standard_quote_tick/daily_thresholds.csv -text
trading_models_v2/assets/*/bars/standard_quote_tick/daily_tick_profile.csv -text


# =====================================================================
# 3. FROZEN MODEL ROWS
# =====================================================================

trading_models_v2/assets/*/edges/*/artifacts/research_dataset/*_model_rows.csv filter=lfs diff=lfs merge=lfs -text

